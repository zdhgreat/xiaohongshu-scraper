# 小红书爬虫环境配置
# 复制此文件为 .env 并填入实际值

# ── Postgres 连接（Hub 统一格式）──
# 代码读取以下 POSTGRES_* 五项（python-dotenv 自动加载 .env）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=xhs
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=financial_hub

# 注意：
# - 不配置时自动使用本地 SQLite（data/xhs.db），不影响爬取
# - Postgres 不可用时自动降级为仅 SQLite
# - 支持 python-dotenv 自动加载 .env 文件
